              "num_columns": 1,
              "num_rows": 1
            },
            {
              "text": "SGUC – define technical and policy solutions",
              "column_start": 1,
              "row_start": 9,
              "num_columns": 1,
              "num_rows": 1
            },
            {
              "text": "1.6. Promote geospatial metadata for standard documentation.",
              "column_start": 0,
              "row_start": 10,
              "num_columns": 2,
              "num_rows": 1
            },
